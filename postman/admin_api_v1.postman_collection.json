{
  "info": {
    "name": "Admin API v1",
    "description": "Read-only admin API checks. Set base_url, admin_token, and manager_token before running. Write workflows are covered by Django API tests to avoid creating test records in a shared database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "manager_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Admin Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/admin/users/?page_size=1"
      },
      "response": [
        {
          "name": "200 OK - Example",
          "originalRequest": { "method": "GET", "url": "{{base_url}}/api/v1/admin/users/?page_size=1" },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "{\"count\":30,\"next\":\"{{base_url}}/api/v1/admin/users/?page=2&page_size=1\",\"previous\":null,\"results\":[{\"id\":3,\"username\":\"Olastickz\",\"first_name\":\"\",\"last_name\":\"\",\"email\":\"[redacted]\",\"is_active\":true,\"is_superuser\":true,\"role\":\"admin\",\"department\":\"ABS\"}]}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin can list users', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('user list is paginated', function () {",
              "    pm.expect(body.count).to.be.a('number');",
              "    pm.expect(body.results).to.be.an('array');",
              "    pm.expect(body.results.length).to.be.at.most(10);",
              "    pm.expect(body).to.have.property('next');",
              "    pm.expect(body).to.have.property('previous');",
              "});"
            ]
          }
        }
      ]
    },
