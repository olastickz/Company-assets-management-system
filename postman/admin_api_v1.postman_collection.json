          }
        ],
        "url": "{{base_url}}/api/v1/admin/roles/"
      },
      "response": [
        {
          "name": "200 OK - Example",
          "originalRequest": { "method": "GET", "url": "{{base_url}}/api/v1/admin/roles/" },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "[{\"value\":\"admin\",\"label\":\"Administrator\"},{\"value\":\"manager\",\"label\":\"Manager\"},{\"value\":\"driver\",\"label\":\"Driver\"},{\"value\":\"staff\",\"label\":\"Staff\"}]"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns the app role catalog', function () {",
              "    pm.response.to.have.status(200);",
              "    const roles = pm.response.json().map(function (role) { return role.value; });",
              "    pm.expect(roles).to.include.members(['admin', 'document_manager', 'vehicle_manager', 'equipment_manager', 'driver', 'staff']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Role Permission Matrix",
      "description": "Read the role permission matrix for all roles. Administrator permissions are locked and always full access.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/admin/roles/permissions/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin can read role permission matrix', function () {",
              "    pm.response.to.have.status(200);",
              "    const roles = pm.response.json();",
              "    pm.expect(roles).to.be.an('array');",
              "    pm.expect(roles).to.have.length(6);",
              "    pm.expect(roles.find(function (role) { return role.value === 'admin'; }).locked).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Read Vehicle Manager Permission Matrix",
      "description": "Read one role's module permissions and approval authority.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/admin/roles/permissions/?role=vehicle_manager"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin can read a single role matrix', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.value).to.eql('vehicle_manager');",
              "    pm.expect(body.modules.vehicles).to.have.property('view');",
              "    pm.expect(body.approval_authority).to.have.property('level_1');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH Role Permissions (Localhost Only)",
      "description": "Changes effective permissions. This request is pinned to localhost to avoid changing the hosted server. Run only against a local or disposable test database.",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"vehicle_manager\",\n  \"modules\": {\n    \"vehicles\": {\"view\": true, \"edit\": true}\n  },\n  \"approval_authority\": {\n    \"level_1\": true,\n    \"level_2\": false\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://127.0.0.1:8000/api/v1/admin/roles/permissions/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('local role permission update is saved', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.value).to.eql('vehicle_manager');",
              "    pm.expect(body.modules.vehicles.edit).to.eql(true);",
              "    pm.expect(body.approval_authority.level_1).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
