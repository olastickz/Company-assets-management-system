{
  "info": {
    "name": "Admin API v1",
    "description": "Admin API v1 checks. Set base_url, admin_token, and manager_token before running. The role-permission PATCH example is pinned to localhost and should only be used with a local or disposable test database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://207.180.246.69:8038"
    },
    {
      "key": "admin_token",
      "value": "{{admin_token}}"
    },
    {
      "key": "manager_token",
      "value": "{{manager_token}}"
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "staff_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Admin Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/admin/users/?page_size=1"
      },
      "response": [
        {
          "name": "200 OK - Example",
          "originalRequest": { "method": "GET", "url": "{{base_url}}/api/v1/admin/users/?page_size=1" },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "{\"count\":1,\"next\":null,\"previous\":null,\"results\":[{\"id\":1,\"username\":\"telnet\",\"first_name\":\"\",\"last_name\":\"\",\"email\":\"topafgg@gmail.com\",\"is_active\":true,\"is_superuser\":true,\"role\":\"admin\",\"department\":null}]}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin can list users', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('user list is paginated', function () {",
              "    pm.expect(body.count).to.be.a('number');",
              "    pm.expect(body.results).to.be.an('array');",
              "    pm.expect(body.results.length).to.be.at.most(10);",
              "    pm.expect(body).to.have.property('next');",
              "    pm.expect(body).to.have.property('previous');",
              "});"
            ]
          }
        }
      ]
    },
    {
