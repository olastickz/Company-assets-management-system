{
  "info": {
    "name": "Local Workflow API",
    "description": "Mutating vehicle maintenance, equipment transfer, and driver assignment workflows. Run only against an isolated development/test database with dedicated test records. Saved response bodies are test fixtures, not live snapshots.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "vehicle_id", "value": "" },
    { "key": "equipment_id", "value": "" },
    { "key": "driver_id", "value": "" },
    { "key": "maintenance_id", "value": "" },
    { "key": "transfer_id", "value": "" },
    { "key": "driver_request_id", "value": "" }
  ],
  "item": [
    {
      "name": "Vehicle maintenance",
      "item": [
        {
          "name": "Create vehicle maintenance record",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Token {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle\": {{vehicle_id}},\n  \"description\": \"API workflow check\",\n  \"cost\": \"25.00\",\n  \"notes\": \"Created by Local Workflow API collection\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vehicle-maintenance/"
          },
          "response": [
            {
              "name": "201 Created - Example",
              "originalRequest": { "method": "POST", "url": "{{base_url}}/api/vehicle-maintenance/" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [],
              "cookie": [],
              "body": "{\"id\":1,\"vehicle\":1,\"vehicle_name\":\"Example Vehicle\",\"description\":\"API workflow check\",\"date_performed\":\"2026-10-09\",\"cost\":\"25.00\",\"notes\":\"Created by Local Workflow API collection\"}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('maintenance record is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.vehicle_name).to.be.a('string');",
                  "    pm.expect(body.description).to.eql('API workflow check');",
                  "    pm.collectionVariables.set('maintenance_id', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List maintenance for vehicle",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
            "url": "{{base_url}}/api/vehicle-maintenance/?vehicle={{vehicle_id}}"
          },
          "response": [
            {
              "name": "200 OK - Example",
              "originalRequest": { "method": "GET", "url": "{{base_url}}/api/vehicle-maintenance/?vehicle={{vehicle_id}}" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "cookie": [],
              "body": "[{\"id\":1,\"vehicle\":1,\"vehicle_name\":\"Example Vehicle\",\"description\":\"API workflow check\",\"date_performed\":\"2026-10-09\",\"cost\":\"25.00\",\"notes\":\"Created by Local Workflow API collection\"}]"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('vehicle maintenance list includes created record', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "    pm.expect(pm.response.json().some(function (item) { return item.id === Number(pm.collectionVariables.get('maintenance_id')); })).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update maintenance notes",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Token {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated by API collection\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vehicle-maintenance/{{maintenance_id}}/"
          },
          "response": [
            {
              "name": "200 OK - Example",
              "originalRequest": { "method": "PATCH", "url": "{{base_url}}/api/vehicle-maintenance/{{maintenance_id}}/" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "cookie": [],
              "body": "{\"id\":1,\"vehicle\":1,\"vehicle_name\":\"Example Vehicle\",\"description\":\"API workflow check\",\"date_performed\":\"2026-10-09\",\"cost\":\"25.00\",\"notes\":\"Updated by API collection\"}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('maintenance notes are updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().notes).to.eql('Updated by API collection');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
