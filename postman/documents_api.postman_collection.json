{
  "info": {
    "name": "Documents API",
    "description": "Document CRUD requests, including multipart file upload. POST, PATCH, and DELETE modify data; run against an isolated development/test database. The list and detail GET examples are current local snapshots captured 2026-10-09.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "delivery_id",
      "value": "1"
    },
    {
      "key": "document_id",
      "value": ""
    },
    {
      "key": "document_file_path",
      "value": "./document-upload.pdf"
    }
  ],
  "item": [
    {
      "name": "Upload Document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "multipart/form-data"
          }
        ],
        "url": "{{base_url}}/api/documents/",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Postman Upload Test",
              "type": "text"
            },
            {
              "key": "document_type",
              "value": "other",
              "type": "text"
            },
            {
              "key": "expiry_date",
              "value": "2027-01-01",
              "type": "text"
            },
            {
              "key": "issue_date",
              "value": "2026-01-01",
              "type": "text"
            },
            {
              "key": "document_file",
              "type": "file",
              "src": "{{document_file_path}}"
            }
          ]
        }
      },
      "response": [
        {
          "name": "201 Created - Test fixture",
          "originalRequest": { "method": "POST", "url": "{{base_url}}/api/documents/" },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "{\"id\":1,\"name\":\"Postman Upload Test\",\"document_type\":\"other\",\"description\":null,\"issuing_authority\":null,\"issue_date\":\"2026-01-01\",\"expiry_date\":\"2027-01-01\",\"renewal_date\":null,\"status\":\"active\",\"document_number\":null,\"related_vehicle\":null,\"related_equipment\":null,\"related_asset\":null,\"notify_days_before\":30,\"location\":null,\"responsible_person\":null,\"responsible_staff\":null,\"notes\":null,\"document_file\":\"/media/company_documents/document-upload.pdf\",\"created_at\":\"2026-10-09T12:00:00Z\",\"updated_at\":\"2026-10-09T12:00:00Z\",\"created_by\":1}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('creates document', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.collectionVariables.set('document_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
