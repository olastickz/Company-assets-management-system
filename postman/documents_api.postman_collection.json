          "cookie": [],
          "body": "{\"id\":17,\"name\":\"Toyota Highlander - Insurance Certificate\",\"document_type\":\"insurance\",\"description\":\"Document for Toyota Highlander (KJA 634 JW)\",\"issuing_authority\":\"Insurance Board\",\"issue_date\":\"2025-06-05\",\"expiry_date\":\"2026-06-23\",\"renewal_date\":null,\"status\":\"active\",\"document_number\":\"INSURANCE-KJA 634 JW-2026\",\"notify_days_before\":30,\"location\":\"Office Safe\",\"responsible_person\":null,\"notes\":\"Sample document for testing. Automatically created.\",\"document_file\":null,\"created_at\":\"2026-06-05T15:14:32.137066+01:00\",\"updated_at\":\"2026-06-05T15:14:32.137109+01:00\",\"related_vehicle\":11,\"related_equipment\":null,\"related_asset\":344,\"responsible_staff\":null,\"created_by\":null}"
