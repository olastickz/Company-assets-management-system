    {
      "name": "Update Uploaded Document",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "multipart/form-data"
          }
        ],
        "url": "{{base_url}}/api/documents/{{document_id}}/",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Postman Updated Document",
              "type": "text"
            }
          ]
        }
      },
      "response": [
        {
